@prefix btid: <http://kbr.be/id/data/> .
@prefix btm: <http://kbr.be/ns/beltrans/model#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oa: <http://www.w3.org/ns/oa#> .

#
# W3C Web Annotations-related motivations that can be used as purpose
#
btid:BELTRANSLanguageAnnotation a skos:Concept, oa:Motiviation ;
  skos:prefLabel "BELTRANS language annotation"@en ;
  skos:note "A more generalized language classification used in the SAMPO-UI instance of BELTRANS." .

btid:GenderCategoryAnnotation a skos:Concept, oa:Motivation ;
  skos:prefLabel "Gender category annotation"@en ;
  skos:note "Annotating a schema:CreativeWork with possible multiple contributors of a certain role with a classification regarding gender."@en .

btm:NumberOfManifestationsPerRoleAnnotation a skos:Concept, oa:Motivation ;
  skos:prefLabel "Number of manifestations per role annotation"@en ;
  skos:note "Annotating a schema:Person with the number of book translations the person contributed to in a specific role."@en .

btm:NumberOfManifestationsAnnotation a skos:Concept, oa:Motivation ;
  skos:prefLabel "Number of manifestations annotation"@en ;
  skos:note "Annotating a schema:Person with the number of book translations the person contributed to."@en .



#
# BELTRANS language classifications
#
btid:dut a skos:Concept ;
         skos:prefLabel "Dutch"@en .

btid:fre a skos:Concept ;
         skos:prefLabel "French"@en .

btid:dutAndOther a skos:Concept ;
                 skos:prefLabel "Dutch and other"@en .

btid:freAndOther a skos:Concept ;
                 skos:prefLabel "French and other"@en .

btid:dutFre a skos:Concept ;
            skos:prefLabel "Dutch and French"@en .

btid:dutFreAndOther a skos:Concept ;
                    skos:prefLabel "Dutch and French and other"@en .

#
# General concepts used e.g. for gender annotation
#

btm:beltransGenderCategory a skos:ConceptScheme ;
        dcterms:title "BELTRANS gender categories" ;
        dcterms:description "A controlled vocabulary to annotate a single gender category for all book contributors of a certain role. E.g. if a book has two authors and both are male, the category is btm:genderCategoryMale. If a book has three illustrators where one is male and two are female, the category is btm:genderCategoryMaleFemale. Terms of this controlled vocabulary are aligned with the Homosaurus. The intention of this controlled vocabulary is to easily filter books to e.g. identify female literature even if there are multiple contributors of a certain role." ;
        rdfs:seeAlso <https://homosaurus.org/v5/homoit0000560> .

btm:genderCategoryMale a skos:Concept ;
        skos:inScheme btm:beltransGenderCategory ;
        skos:prefLabel "Male"@en ;
        skos:prefLabel "Mannelijk"@nl ;
        skos:prefLabel "Homme"@fr ;
        skos:prefLabel "Männlich"@de ;
        skos:altLabel "BELTRANS gender category male"@en ;
        skos:altLabel "BELTRANS gendercategorie mannelijk"@nl ;
        skos:altLabel "BELTRANS catégorie de genre homme"@fr ;
        skos:altLabel "BELTRANS Geschlechtskategorie männlich"@de ;
        skos:relatedMatch <https://homosaurus.org/v5/homoit0001008> ;
        skos:note "All book contributors of a certain role have the gender male." ;
        rdfs:seeAlso <https://homosaurus.org/v5/homoit0001008> .

btm:genderCategoryFemale a skos:Concept ;
        skos:inScheme btm:beltransGenderCategory ;
        skos:prefLabel "Female"@en ;
        skos:prefLabel "Vrouwelijk"@nl ;
        skos:prefLabel "Femme"@fr ;
        skos:prefLabel "Weiblich"@de ;
        skos:altLabel "BELTRANS gender category female"@en ;
        skos:altLabel "BELTRANS gendercategorie vrouwelijk"@nl ;
        skos:altLabel "BELTRANS catégorie de genre femme"@fr ;
        skos:altLabel "BELTRANS Geschlechtskategorie weiblich"@de ;
        skos:relatedMatch <https://homosaurus.org/v5/homoit0001509> ;
        skos:note "All book contributors of a certain role have the gender female." ;
        rdfs:seeAlso <https://homosaurus.org/v5/homoit0001509> .

btm:genderCategoryMinority a skos:Concept ;
        skos:inScheme btm:beltransGenderCategory ;
        skos:prefLabel "Minority"@en ;
        skos:prefLabel "Minderheid"@nl ;
        skos:prefLabel "Femme"@fr ;
        skos:prefLabel "Minderheit"@de ;
        skos:altLabel "BELTRANS gender category minority"@en ;
        skos:altLabel "BELTRANS gendercategorie vrouwelijk"@nl ;
        skos:altLabel "BELTRANS catégorie de genre femme"@fr ;
        skos:altLabel "BELTRANS Geschlechtskategorie minderheit"@de ;
        skos:relatedMatch <https://homosaurus.org/v5/homoit0001817> ;
        skos:note "All book contributors of a certain role have a gender different from those of the dominant binary gender culture. See https://homosaurus.org/v5/homoit0001817" ;
        rdfs:seeAlso <https://homosaurus.org/v5/homoit0001817> .

btm:genderCategoryMaleFemale a skos:Concept ;
        skos:inScheme btm:beltransGenderCategory ;
        skos:prefLabel "Male and female"@en ;
        skos:prefLabel "Mannelijk en vrouwelijk"@nl ;
        skos:prefLabel "Homme et femme"@fr ;
        skos:prefLabel "Männlich und weiblich"@de ;
        skos:altLabel "BELTRANS gender category male and female"@en ;
        skos:altLabel "BELTRANS gendercategorie mannelijk en vrouwelijk"@nl ;
        skos:altLabel "BELTRANS catégorie de genre homme et femme"@fr ;
        skos:altLabel "BELTRANS Geschlechtskategorie männlich und weiblich"@de ;
        skos:related btm:genderCategoryMale ;
        skos:related btm:genderCategoryFemale ;
        skos:note "There are at least two book contributors of a certain role, some of them are male and some female." .

btm:genderCategoryBinaryAndMinority a skos:Concept ;
        skos:inScheme btm:beltransGenderCategory ;
        skos:prefLabel "Binary and minority"@en ;
        skos:prefLabel "Binair en minderheid"@nl ;
        skos:prefLabel "Binaire et minorité"@fr ;
        skos:prefLabel "Binär und Minderheit"@de ;
        skos:altLabel "BELTRANS gender category binary and minority"@en ;
        skos:altLabel "BELTRANS gendercategorie binair en minderheid"@nl ;
        skos:altLabel "BELTRANS catégorie de genre binaire et minorité"@fr ;
        skos:altLabel "BELTRANS Geschlechtskategorie binär und Minderheit"@de ;
        skos:related btm:genderCategoryMale ;
        skos:related btm:genderCategoryFemale ;
        skos:related btm:genderCategoryMinority ;
        skos:note "There are at least two book contributors of a certain role, some of them them identify with a binary gender and some with a minority gender. See https://homosaurus.org/v5/homoit0001817" .

